{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bonnington-ui",
  "version": "0.1.0",
  "identifier": "local.bonnington.ui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bonnington",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#000000",
        "center": true,
        "minWidth": 360,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
